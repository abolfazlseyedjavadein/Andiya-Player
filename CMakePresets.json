{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "$env{ANDIYA_BUILD_DIR}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
        "ANDIYA_DEPLOY_RUNTIME": "OFF"
      }
    },
    {
      "name": "package",
      "inherits": "release",
      "displayName": "Release package",
      "cacheVariables": {"ANDIYA_DEPLOY_RUNTIME": "ON"}
    }
  ],
  "buildPresets": [{"name": "release", "configurePreset": "release", "configuration": "Release"}]
}
