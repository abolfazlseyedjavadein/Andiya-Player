{
  "id": "example.redaction-blur",
  "name": "Redaction Blur",
  "vendor": "Andiya Example Plugins",
  "description": "Blur a manually positioned rectangle on an image or video frame.",
  "version": "1.3.0",
  "andiyaApi": "1.0",
  "execution": "python",
  "runtime": "process",
  "entrypoint": "filter.py",
  "capabilities": ["image-filter", "video-filter"],
  "permissions": ["frame-access"],
  "performance": {
    "realtime": false,
    "gpu": false
  },
  "enabled": false,
  "rectangle": {"x": "x", "y": "y", "width": "width", "height": "height"},
  "actions": [
    {"id": "draw_rectangle", "label": "Draw rectangle", "type": "rectangle"},
    {"id": "reset_rectangle", "label": "Reset rectangle", "type": "button"}
  ],
  "parameters": [
    {"key": "x", "label": "X", "min": 0, "max": 1, "default": 0.1, "step": 0.01},
    {"key": "y", "label": "Y", "min": 0, "max": 1, "default": 0.1, "step": 0.01},
    {"key": "width", "label": "Width", "min": 0.01, "max": 1, "default": 0.3, "step": 0.01},
    {"key": "height", "label": "Height", "min": 0.01, "max": 1, "default": 0.2, "step": 0.01},
    {"key": "radius", "label": "Blur radius (pixels)", "min": 1, "max": 64, "default": 16, "step": 1}
  ]
}
