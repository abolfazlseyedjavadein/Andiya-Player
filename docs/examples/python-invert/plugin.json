{
  "id": "example.python-invert",
  "name": "Python Invert",
  "vendor": "Andiya Example Plugins",
  "description": "Invert RGB while preserving alpha, with an adjustable amount.",
  "version": "1.0.0",
  "andiyaApi": "1.0",
  "execution": "python",
  "runtime": "process",
  "entrypoint": "filter.py",
  "capabilities": [
    "image-filter",
    "video-filter"
  ],
  "permissions": [
    "frame-access"
  ],
  "performance": {
    "realtime": false,
    "gpu": false
  },
  "accent": "#43D19E",
  "enabled": false,
  "parameters": [
    {
      "key": "amount",
      "label": "Amount",
      "min": 0,
      "max": 1,
      "default": 1,
      "step": 0.01
    }
  ]
}
